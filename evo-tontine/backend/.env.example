# Copier vers .env et changer la secret avant tout déploiement.
EVO_TONTINE_DATABASE_URL=sqlite:///./evotontine.db
EVO_TONTINE_JWT_SECRET=remplacer-par-un-secret-long-et-aleatoire
EVO_TONTINE_JWT_TTL_HOURS=12
EVO_TONTINE_COOKIE_NAME=evo_tontine_session
EVO_TONTINE_PUBLIC_BASE_URL=http://localhost:3500
EVO_TONTINE_COOKIE_SECURE=false
EVO_TONTINE_SEED_DEMO=true
EVO_TONTINE_DEMO_MODE=true
EVO_TONTINE_CORS_ORIGINS=http://localhost:3500,http://127.0.0.1:3500
