# Configuration du backend - copier en .env et ajuster.

EVO_DOCS_DATABASE_URL="sqlite:///./evo_docs.db"
EVO_DOCS_JWT_SECRET="dev-seulement-evo_docs-secret-a-remplacer-32-caracteres"
