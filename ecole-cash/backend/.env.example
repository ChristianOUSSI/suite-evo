# Copier vers .env et changer le secret avant tout déploiement.
CASH_DATABASE_URL=sqlite:///./ecole_cash.db
CASH_JWT_SECRET=remplacer-par-un-secret-long-et-aleatoire
CASH_JWT_TTL_HOURS=10
CASH_COOKIE_NAME=cash_session
CASH_PUBLIC_BASE_URL=http://localhost:3200
CASH_COOKIE_SECURE=false
CASH_SEED_DEMO=true
CASH_DEMO_MODE=true
CASH_CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
