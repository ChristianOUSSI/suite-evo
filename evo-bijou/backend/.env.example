# Configuration du backend - copier en .env et ajuster.

EVO_BIJO_DATABASE_URL="sqlite:///./evo_bijou.db"
EVO_BIJO_JWT_SECRET="dev-seulement-evo_bijou-secret-a-remplacer-32-caracteres"
EVO_BIJO_JWT_TTL_HOURS=12
EVO_BIJO_COOKIE_NAME="evo_bijou_session"
EVO_BIJO_COOKIE_SECURE=False
EVO_BIJO_PUBLIC_BASE_URL="http://localhost:5000"
EVO_BIJO_DEMO_MODE=True
EVO_BIJO_SEED_DEMO=True
EVO_BIJO_CORS_ORIGINS="http://localhost:5000,http://127.0.0.1:5000"
