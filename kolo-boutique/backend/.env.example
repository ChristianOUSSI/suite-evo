# Copier vers .env et changer le secret avant tout déploiement.
KOLO_DATABASE_URL=sqlite:///./koloboutique.db
KOLO_JWT_SECRET=remplacer-par-un-secret-long-et-aleatoire
KOLO_JWT_TTL_HOURS=12
KOLO_COOKIE_NAME=kolo_session
KOLO_PUBLIC_BASE_URL=http://localhost:3400
KOLO_COOKIE_SECURE=false
KOLO_SEED_DEMO=true
KOLO_DEMO_MODE=true
KOLO_CORS_ORIGINS=http://localhost:3400,http://127.0.0.1:3400
