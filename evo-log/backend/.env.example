# Configuration du backend - copier en .env et ajuster.

EVO_LOG_DATABASE_URL="sqlite:///./evo_log.db"
EVO_LOG_JWT_SECRET="dev-seulement-evo_log-secret-a-remplacer-32-caracteres"
EVO_LOG_JWT_TTL_HOURS=12
EVO_LOG_COOKIE_NAME="evo_log_session"
EVO_LOG_COOKIE_SECURE=False
EVO_LOG_PUBLIC_BASE_URL="http://localhost:4400"
EVO_LOG_DEMO_MODE=True
EVO_LOG_SEED_DEMO=True
EVO_LOG_CORS_ORIGINS="http://localhost:4400,http://127.0.0.1:4400"
