# Copier vers .env et changer le secret avant tout déploiement.
VOICE_DATABASE_URL=sqlite:///./voice.db
VOICE_JWT_SECRET=remplacer-par-un-secret-long-et-aleatoire
VOICE_JWT_TTL_HOURS=12
VOICE_COOKIE_NAME=voice_session
VOICE_PUBLIC_BASE_URL=http://localhost:3100
VOICE_COOKIE_SECURE=false
VOICE_SEED_DEMO=true
VOICE_DEMO_MODE=true
VOICE_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
